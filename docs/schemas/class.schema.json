{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Yorehold class (classes/<id>.json)",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$",
      "description": "a-z, 0-9, - and _; the file name without .json"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "hitDie": {
      "type": "integer"
    },
    "bonusHp": {
      "type": "integer"
    },
    "speed": {
      "type": "integer"
    },
    "darkvision": {
      "type": "integer"
    },
    "dcAbility": {
      "type": "string"
    },
    "proficiencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,64}$",
        "description": "a-z, 0-9, - and _; the file name without .json"
      }
    },
    "proficiencyRanks": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,64}$",
        "description": "a-z, 0-9, - and _; the file name without .json"
      }
    },
    "resources": {
      "type": "object"
    },
    "casting": {
      "enum": [
        "known",
        "prepared",
        "spontaneous"
      ]
    },
    "restores": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "more resources a rest gives back to this class, by rest id: {\"short\": [\"slots-*\"]}"
    },
    "spells": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$",
          "description": "a-z, 0-9, - and _; the file name without .json"
        }
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,64}$",
                  "description": "a-z, 0-9, - and _; the file name without .json"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "modifiers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "stat",
                      "value"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "stat": {
                        "type": "string",
                        "description": "the number it changes: ac, attack, damage, saves, checks, speed, maxHp, initiative, an ability, resist.fire..."
                      },
                      "op": {
                        "enum": [
                          "add",
                          "multiply",
                          "override",
                          "max",
                          "min"
                        ],
                        "description": "max: at least this much; min: at most"
                      },
                      "value": {
                        "type": "number"
                      },
                      "type": {
                        "type": "string",
                        "description": "typed bonuses don't stack: only the best of each type counts"
                      },
                      "if": {
                        "type": "string",
                        "description": "makes it situational: it counts only on a roll this holds for (ranged, save.dex, trait.agile, targetFlag.undead)"
                      }
                    }
                  }
                },
                "proficiencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]{1,64}$",
                    "description": "a-z, 0-9, - and _; the file name without .json"
                  }
                },
                "ranks": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "resources": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "the system's granted-only actions, reactions and triggers"
                },
                "spells": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]{1,64}$",
                    "description": "a-z, 0-9, - and _; the file name without .json"
                  },
                  "description": "spells it knows from this: cantrips at will, others with a slot"
                }
              }
            }
          },
          "ranks": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "feats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "the feat kinds picked at this level"
          },
          "skills": {
            "type": "integer"
          },
          "slots": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "spells": {
            "type": "integer"
          },
          "boosts": {
            "type": "integer"
          },
          "boostStep": {
            "type": "integer"
          },
          "boostsRepeat": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "option kinds picked at this level (a subclass)"
          },
          "scale": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "named numbers reached at this level, read as scale.<id>"
          }
        }
      }
    }
  }
}
