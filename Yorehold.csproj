<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Godot 4.6's Android templates only take net9.0 (docs/EXPORT.md). -->
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>Yorehold</RootNamespace>
    <!-- The rules library, its tests and the OCR helper build on their own; keep them out of the game project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);rules/**;tests/**;ocr/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="rules\Yorehold.Rules.csproj" />
  </ItemGroup>
</Project>
